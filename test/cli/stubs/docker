#!/usr/bin/env bash
# Stub of docker for test/cli: records its argument vector as one line of $STUB_LOG, each argument in brackets.
# It models the container and the two configuration hashes through these variables:
# - STUB_CONTAINER_ID: `docker compose -f <file> ps …` prints it (nothing when unset: no container).
# - STUB_RUNNING_HASH: `docker inspect …` prints it, the hash label of the container (empty when unset).
# - STUB_CONFIG_HASH: `docker compose -f <file> config …` prints `cc <hash>`, as `config --hash cc` does
#   (nothing when unset).
# - STUB_DOCKER_FAIL names a subcommand that fails: `up` prints an error and exits 1; `ps`, `inspect` and
#   `config` first print their normal output, then the error, and exit 1, so that a caller that reads the
#   output without checking the exit status is caught. It fails a plain `docker ps` too.
# - STUB_DOCKER_PS: a plain `docker ps …` (not `docker compose … ps`) prints it verbatim, one `id name` line per
#   running container (nothing when unset: no running containers).
# - STUB_DOCKER_EXEC: a directory scripting a plain `docker exec <id> pgrep -a -f <pattern>`. Where
#   `<id>.status` exists, the stub prints `<id>.out` to stdout and `<id>.err` to stderr (each if present) and
#   exits with that status. Otherwise it reads `<id>.procs` (lines `pid cmdline`; absent: no processes), prints
#   each line whose cmdline matches the pattern under `grep -E`, as `pgrep -a` would, and exits 0 if any
#   matched, else 1 with nothing on stderr.
# - STUB_SESSION_ID: `docker compose -f <file> exec -T cc sh -c <script>` prints it, the session the lookup of
#   bin/ilcli run finds (nothing when unset: no earlier conversation).
# - STUB_DOCKER_MOUNTS: a directory scripting a plain `docker inspect --format <template> <id>` whose template
#   contains `.Mounts`. Where `<id>.inspect-status` exists, the stub prints `<id>.inspect-err` to stderr (if
#   present) and exits with that status. Otherwise it prints `<id>.mounts` (lines `source<TAB>destination`, the
#   output of MOUNTS_TEMPLATE in bin/ilcli.bashly/lib/common.sh; absent: no mounts) and exits 0. Every other
#   `docker inspect` prints STUB_RUNNING_HASH as above.
line=docker
for a in "$@"; do line+=" [$a]"; done
printf '%s\n' "$line" >> "$STUB_LOG"

if [[ ${1:-} == compose ]]; then
  sub=${4:-}
else
  sub=${1:-}
fi

if [[ ${1:-} == compose && ${4:-} == exec && ${5:-} == -T ]]; then
  [[ -n ${STUB_SESSION_ID:-} ]] && printf '%s\n' "$STUB_SESSION_ID"
  exit 0
fi

if [[ ${1:-} == exec ]]; then
  id=${2:-}
  pattern=${6:-}
  dir=${STUB_DOCKER_EXEC:-/nonexistent}
  if [[ -f $dir/$id.status ]]; then
    [[ -f $dir/$id.out ]] && cat "$dir/$id.out"
    [[ -f $dir/$id.err ]] && cat "$dir/$id.err" >&2
    exit "$(cat "$dir/$id.status")"
  fi
  matched=1
  if [[ -f $dir/$id.procs ]]; then
    while IFS= read -r procline; do
      if grep -qE -- "$pattern" <<< "${procline#* }"; then
        printf '%s\n' "$procline"
        matched=0
      fi
    done < "$dir/$id.procs"
  fi
  exit "$matched"
fi

if [[ ${1:-} == inspect && ${2:-} == --format && ${3:-} == *.Mounts* ]]; then
  id=${4:-}
  dir=${STUB_DOCKER_MOUNTS:-/nonexistent}
  if [[ -f $dir/$id.inspect-status ]]; then
    [[ -f $dir/$id.inspect-err ]] && cat "$dir/$id.inspect-err" >&2
    exit "$(cat "$dir/$id.inspect-status")"
  fi
  [[ -f $dir/$id.mounts ]] && cat "$dir/$id.mounts"
  exit 0
fi

case $sub in
  ps)
    if [[ ${1:-} == ps ]]; then
      [[ -n ${STUB_DOCKER_PS:-} ]] && printf '%s\n' "$STUB_DOCKER_PS"
    else
      [[ -n ${STUB_CONTAINER_ID:-} ]] && printf '%s\n' "$STUB_CONTAINER_ID"
    fi
    ;;
  inspect) printf '%s\n' "${STUB_RUNNING_HASH:-}" ;;
  config) [[ -n ${STUB_CONFIG_HASH:-} ]] && printf 'cc %s\n' "$STUB_CONFIG_HASH" ;;
esac

if [[ -n ${STUB_DOCKER_FAIL:-} && $sub == "$STUB_DOCKER_FAIL" ]]; then
  echo "stub: compose $STUB_DOCKER_FAIL failed" >&2
  exit 1
fi
exit 0
