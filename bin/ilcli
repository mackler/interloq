ilcli_web_usage() {
  if [[ -n $long_usage ]]; then
    printf "ilcli web\n\n"
    printf "  Start the container if needed, then start Interloq's web server in it, in the\n  foreground; Ctrl+C ends it\n  \n  The port defaults to 8090, the one compose.cc.yaml publishes (8090:8090), at\n  http://localhost:8090/. A server on another port is not reachable from the\n  host until that ports line is changed and the container is recreated\n  (bin/ilcli down, then bin/ilcli web), not restarted: an existing container is\n  never recreated by run, shell or web, which instead say on stderr that its\n  configuration is older than compose.cc.yaml gives in this shell. The server\n  refuses to start until the page is built: npm run build in the installed copy,\n  which bin/ilcli upgrade does. --help and -h show this usage.\n\n"
  else
    printf "ilcli web - Start the container if needed, then start Interloq's web server in it, in the foreground; Ctrl+C ends it\n\n"
  fi

  printf "%s\n" "Usage:"
  printf "  ilcli web [--] [PORT...]\n"
  printf "  ilcli web --help | -h\n"
  echo

  if [[ -n "$long_usage" ]]; then

    printf "%s\n" "Options:"

    printf "  %s\n" "--help, -h"
    printf "    Show this help\n"
    echo

    printf "%s\n" "Arguments:"

    echo "  PORT..."
    printf "    Passed to node /opt/interloq/src/web.ts unchanged: [port]\n"
    echo

    printf "%s\n" "Examples:"
    printf "  bin/ilcli web           port 8090\n"
    printf "  bin/ilcli web 8091      port 8091, reachable from the host only after\n  compose.cc.yaml is changed and the container recreated\n"
    echo

  fi
}

