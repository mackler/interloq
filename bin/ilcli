ilcli_upgrade_usage() {
  if [[ -n $long_usage ]]; then
    printf "ilcli upgrade\n\n"
    printf "  Bring the installed copy to origin/release, then npm ci and npm run build\n  \n  Run on the host in the installed copy: on branch release tracking\n  origin/release, with no local changes and no commits that origin/release\n  lacks. Nothing is changed if a check fails. npm ci and npm run build run every\n  time, so running it again repeats a failed install or build. Afterwards\n  restart the web server and reload the open tabs.\n  \n  Before changing anything, upgrade looks in every running container (docker ps,\n  then docker exec ... pgrep) for a process whose command line names the\n  installed copy, which the containers mount at /opt/interloq: the web server,\n  the Claude Code and Codex binaries, or anything else. A docker launcher on the\n  host does not count. It refuses if it finds one, naming the containers and the\n  command lines. Replacing those files can kill a running agent at any later\n  point until its run ends, not only during the update; a run waiting for an\n  answer still has its web server running, so it is found too.\n  \n  It also refuses when it cannot make the check: docker missing, docker ps\n  failing, or a container where the search fails, for example one without pgrep.\n  --force skips the check. A run started outside a container is not detected.\n\n"
  else
    printf "ilcli upgrade - Bring the installed copy to origin/release, then npm ci and npm run build\n\n"
  fi

  printf "%s\n" "Usage:"
  printf "  ilcli upgrade [OPTIONS]\n"
  printf "  ilcli upgrade --help | -h\n"
  echo

  if [[ -n "$long_usage" ]]; then

    printf "%s\n" "Options:"

    printf "  %s\n" "--force"
    printf "    Skip the check for processes using the installed copy\n"
    echo

    printf "  %s\n" "--help, -h"
    printf "    Show this help\n"
    echo

    printf "%s\n" "Examples:"
    printf "  bin/ilcli upgrade           refuses while a container runs anything from the\n  installed copy\n"
    printf "  bin/ilcli upgrade --force   skips that check\n"
    echo

  fi
}

