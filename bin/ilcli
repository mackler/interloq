ilcli_upgrade_usage() {
  if [[ -n $long_usage ]]; then
    printf "ilcli upgrade\n\n"
    printf "  Bring the installed copy to origin/release, then npm ci and npm run build\n  \n  Run on the host in the installed copy: on branch release tracking\n  origin/release, with no local changes and no commits that origin/release\n  lacks. Nothing is changed if a check fails. npm ci and npm run build run every\n  time, so running it again repeats a failed install or build. Afterwards\n  restart the web server and reload the open tabs.\n\n"
  else
    printf "ilcli upgrade - Bring the installed copy to origin/release, then npm ci and npm run build\n\n"
  fi

  printf "%s\n" "Usage:"
  printf "  ilcli upgrade\n"
  printf "  ilcli upgrade --help | -h\n"
  echo

  if [[ -n "$long_usage" ]]; then

    printf "%s\n" "Options:"

    printf "  %s\n" "--help, -h"
    printf "    Show this help\n"
    echo

  fi
}

