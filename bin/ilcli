#!/usr/bin/env bash
# bin/ilcli -- the development container of Interloq, and the route of a change to the installed copy.
# Generated by bashly from bin/ilcli.bashly/; do not edit this file. Edit the sources, then run
# `npm run generate:cli` (needs bashly from the container image); test/cli/generated.bats fails until then.
# The usage text is generated from bin/ilcli.bashly/bashly.yml and documents every command: bin/ilcli help.
if ((BASH_VERSINFO[0] < 4 || (BASH_VERSINFO[0] == 4 && BASH_VERSINFO[1] < 2))); then
  printf "ilcli: bash 4.2 or later is required\n" >&2
  exit 1
fi

version_command() {
  echo "$version"
}

ilcli_usage() {
  if [[ -n $long_usage ]]; then
    printf "ilcli\n\n"
    printf "  Interloq's development container, and the route of a change to the installed\n  copy.\n  \n  The docker commands (run, shell, web, build, down) and release run on the host\n  in the development clone; upgrade runs on the host in the installed copy\n  (~/work/interloq). The script uses compose.cc.yaml in the root of the clone\n  that contains it, and that file mounts the same clone at /workspace.\n  \n  run, shell and web create the container only when none exists and never\n  recreate a running one, so none of them stops a program another started. The\n  container keeps the configuration it was created with, the credential\n  variables of the shell that created it included; when compose.cc.yaml, or the\n  variables of the shell in use, resolve differently, these commands say so on\n  stderr and start in the container as it is. bin/ilcli down, then a start,\n  applies the new configuration, and down stops Claude Code and the web server\n  running in the container.\n  \n  Any first argument that is not a command, --version and -v included, is passed\n  to claude, so run can be left out. After any command, --help and -h show that\n  command's usage; -- passes the rest on to the program the command starts\n  (bin/ilcli run -- --help).\n  \n  The route of a change: commit on main, bin/ilcli release (pushes main), CI\n  runs npm test on GitHub and advances the release branch only if it passes,\n  then bin/ilcli upgrade in the installed copy. The installed copy follows\n  release, so it can only ever install a commit whose tests passed.\n\n"
  else
    printf "ilcli - Interloq's development container, and the route of a change to the installed copy.\n\n"
  fi

  printf "%s\n" "Usage:"
  printf "  ilcli [COMMAND]\n"
  printf "  ilcli [COMMAND] --help | -h\n"
  printf "  ilcli --version | -v\n"
  echo

  printf "%s\n" "Commands:"
  printf "  %s   Start the container if needed, then start Claude Code in it (default)\n" "run    "
  printf "  %s   Start the container if needed, then open a Bash shell in it\n" "shell  "
  printf "  %s   Start the container if needed, then start Interloq's web server in it, in the foreground; Ctrl+C ends it\n" "web    "
  printf "  %s   Build the image from ../claude-code-image\n" "build  "
  printf "  %s   Stop and remove the container (the volumes are kept)\n" "down   "
  printf "  %s   Push main to GitHub, where CI runs npm test and advances release only if it passes\n" "release"
  printf "  %s   Bring the installed copy to origin/release, then npm ci and npm run build\n" "upgrade"
  printf "  %s   Show this text, or the usage of one command\n" "help   "
  echo

  if [[ -n "$long_usage" ]]; then

    printf "%s\n" "Options:"

    printf "  %s\n" "--help, -h"
    printf "    Show this help\n"
    echo
    printf "  %s\n" "--version, -v"
    printf "    Passed to claude, as in bin/ilcli run --version\n"
    echo

  fi
}

ilcli_run_usage() {
  if [[ -n $long_usage ]]; then
    printf "ilcli run\n\n"
    printf "  Start the container if needed, then start Claude Code in it\n  \n  An existing container is never recreated; if its configuration is older than\n  compose.cc.yaml gives in this shell, a note on stderr says so and that\n  bin/ilcli down, then a start, applies it.\n  \n  --help and -h show this usage; -- passes the rest on to claude unchanged, so\n  bin/ilcli run -- --help is Claude Code's own help.\n  \n  -c, --continue   continue the most recent session (passed to claude, not read\n  by ilcli)\n\n"
  else
    printf "ilcli run - Start the container if needed, then start Claude Code in it\n\n"
  fi

  printf "%s\n" "Usage:"
  printf "  ilcli [run] [--] [CLAUDE ARGUMENTS...]\n"
  printf "  ilcli run --help | -h\n"
  echo

  if [[ -n "$long_usage" ]]; then

    printf "%s\n" "Options:"

    printf "  %s\n" "--help, -h"
    printf "    Show this help\n"
    echo

    printf "%s\n" "Arguments:"

    echo "  CLAUDE ARGUMENTS..."
    printf "    Passed to claude unchanged, -- included\n"
    echo

    printf "%s\n" "Examples:"
    printf "  bin/ilcli                  new session\n"
    printf "  bin/ilcli --continue       most recent session\n"
    printf "  bin/ilcli run -c           most recent session\n"
    printf "  bin/ilcli run --resume     session list\n"
    printf "  bin/ilcli run -- --help    Claude Code's own help\n"
    printf "  bin/ilcli run --help       this usage\n"
    echo

  fi
}

