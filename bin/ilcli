}

ilcli_upgrade_parse_requirements() {
  local key

  while [[ $# -gt 0 ]]; do
    key="$1"
    case "$key" in
      --help | -h)
        long_usage=yes
        ilcli_upgrade_usage
        exit
        ;;

      *)
        break
        ;;

    esac
  done

  action="upgrade"

  while [[ $# -gt 0 ]]; do
    key="$1"
    case "$key" in

      --force)

        args['--force']=1
        shift
        ;;

      --)
        shift
        while [[ $# -gt 0 ]]; do
          key="$1"

          printf "invalid argument: %s\n" "$key" >&2
          exit 1

        done
        break
        ;;

      -?*)
        printf "invalid option: %s\n" "$key" >&2
        exit 1
        ;;

      *)

        printf "invalid argument: %s\n" "$key" >&2
        exit 1

        ;;

    esac
  done

}

ilcli_help_parse_requirements() {
  local key

  while [[ $# -gt 0 ]]; do
    key="$1"
    case "$key" in
      --help | -h)
        long_usage=yes
        ilcli_help_usage
        exit
        ;;

      *)
        break
        ;;

    esac
  done

  action="help"

  while [[ $# -gt 0 ]]; do
    key="$1"
    case "$key" in

      --)
        shift
        while [[ $# -gt 0 ]]; do
          key="$1"

          if [[ -z ${args['command']+x} ]]; then
            args['command']=$1
            shift
          else
            printf "invalid argument: %s\n" "$key" >&2
            exit 1
          fi

        done
        break
        ;;

      -?*)
        printf "invalid option: %s\n" "$key" >&2
        exit 1
        ;;

      *)

        if [[ -z ${args['command']+x} ]]; then
          args['command']=$1
          shift
        else
          printf "invalid argument: %s\n" "$key" >&2
          exit 1
        fi

        ;;

    esac
  done

  if [[ -n ${args['command']:-} ]] && [[ ! ${args['command']:-} =~ ^(run|shell|web|build|down|release|upgrade|help)$ ]]; then
    printf "%s\n" "command must be one of: run, shell, web, build, down, release, upgrade, help" >&2
    exit 1
  fi

}

initialize() {
  declare -g version="1"
  set -euo pipefail

  if [[ ${command_line_args[0]:-} == "--version" || ${command_line_args[0]:-} == "-v" ]]; then
    command_line_args=(run "${command_line_args[@]}")
  fi
  declare -g -a ilcli_argv=("${command_line_args[@]}")

}

run() {

  declare -g long_usage=''
  declare -g -A args=()
  declare -g -a other_args=()
  declare -g -A deps=()
  declare -g -a env_var_names=()
  declare -g -a input=()

  normalize_input "$@"
  parse_requirements "${input[@]}"

  case "$action" in
    "run") ilcli_run_command ;;
    "shell") ilcli_shell_command ;;
    "web") ilcli_web_command ;;
    "build") ilcli_build_command ;;
    "down") ilcli_down_command ;;
    "release") ilcli_release_command ;;
    "upgrade") ilcli_upgrade_command ;;
    "help") ilcli_help_command ;;
  esac
}

start() {
  command_line_args=("$@")
  initialize
  run "${command_line_args[@]}"
}

start "$@"
