{
  "name": "interloq",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.283",
    "@effect/platform-node": "4.0.1",
    "@openai/codex-sdk": "0.155.1",
    "effect": "4.0.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@sveltejs/vite-plugin-svelte": "6.2.4",
    "@types/node": "^22",
    "dompurify": "3.4.16",
    "fast-check": "4.10.2",
    "jsdom": "30.1.1",
    "m3-svelte": "7.2.1",
    "marked": "18.0.14",
    "svelte": "5.57.1",
    "svelte-check": "4.7.6",
    "typescript": "^5.8",
    "vite": "7.3.6",
    "vite-plugin-functions-mixins": "0.4.1",
    "vitest": "5.0.2"
  },
  "scripts": {
    "check": "tsc --noEmit && tsc --noEmit -p web && svelte-check --tsconfig web/tsconfig.json --fail-on-warnings",
    "build": "vite build --config web/vite.config.ts",
    "test:unit": "node --test test/*.test.ts",
    "test:cli": "bats test/cli",
    "test:web": "vitest run --config web/vite.config.ts",
    "test:e2e": "playwright test",
    "test": "node scripts/test-all.ts",
    "generate:cli": "BASHLY_SETTINGS_PATH=bin/ilcli.bashly/settings.yml bashly generate --quiet"
  }
}
